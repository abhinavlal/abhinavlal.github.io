---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import config from "@/config";
---

<Layout
  title={`Projects | ${config.site.title}`}
  description="A hand-picked set of projects from my GitHub."
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Projects"
    pageDesc="A few things I've been building — stats pulled live from the GitHub API."
  >
    <ul id="repo-grid" class="grid gap-4 sm:grid-cols-2" hidden></ul>

    <noscript>
      <p class="border-border rounded-md border border-dashed p-4 text-sm">
        JavaScript is off, so the project cards can't render — browse everything
        directly on
        <a
          class="text-accent underline underline-offset-4"
          href="https://github.com/abhinavlal?tab=repositories"
        >
          GitHub
        </a>.
      </p>
    </noscript>

    <div class="mt-8">
      <LinkButton
        href="https://github.com/abhinavlal?tab=repositories"
        class="hover:text-accent underline decoration-dashed underline-offset-4"
      >
        All repositories on GitHub &rarr;
      </LinkButton>
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  // The showcase list, in display order. Only these repos are shown.
  const SHOWCASE = ["foundation", "skillet", "lede", "saas-data-exporter"];

  interface Repo {
    name: string;
    html_url: string;
    description: string | null;
    language: string | null;
    stargazers_count: number;
    pushed_at: string | null;
  }

  // Static fallbacks so all four cards render even if the GitHub API is
  // unreachable. Live API data overrides these when available.
  const FALLBACKS: Record<string, Repo> = {
    foundation: {
      name: "foundation",
      html_url: "https://github.com/abhinavlal/foundation",
      description: null,
      language: "TypeScript",
      stargazers_count: 0,
      pushed_at: null,
    },
    skillet: {
      name: "skillet",
      html_url: "https://github.com/abhinavlal/skillet",
      description: null,
      language: "TypeScript",
      stargazers_count: 0,
      pushed_at: null,
    },
    lede: {
      name: "lede",
      html_url: "https://github.com/abhinavlal/lede",
      description: null,
      language: "TypeScript",
      stargazers_count: 0,
      pushed_at: null,
    },
    "saas-data-exporter": {
      name: "saas-data-exporter",
      html_url: "https://github.com/abhinavlal/saas-data-exporter",
      description: null,
      language: null,
      stargazers_count: 0,
      pushed_at: null,
    },
  };

  // Descriptions for repos that have none set on GitHub.
  const DESCRIPTIONS: Record<string, string> = {
    foundation:
      "A multi-user, installable app starter — Google sign-in, per-user data, a typed API, and an installable PWA, so a new self-hosted app is just your tables and screens on top.",
    skillet:
      "A shared kitchen for two — paste a recipe link, video, or photo and it extracts ingredients, steps, and macros; plan the week and shop the aggregated list.",
    lede:
      "The part worth reading, first — pulls newsletters out of Gmail, filters out the marketing, and presents the writing in a calm three-pane reader.",
  };

  const LANG_COLORS: Record<string, string> = {
    JavaScript: "#f1e05a",
    TypeScript: "#3178c6",
    Python: "#3572a5",
    Ruby: "#701516",
    PHP: "#4f5d95",
    Go: "#00add8",
    Shell: "#89e051",
    HTML: "#e34c26",
    CSS: "#563d7c",
    Vue: "#41b883",
    Rust: "#dea584",
    Java: "#b07219",
    Astro: "#ff5a03",
    "Jupyter Notebook": "#da5b0b",
  };

  function esc(s: unknown): string {
    const d = document.createElement("div");
    d.textContent = s == null ? "" : String(s);
    return d.innerHTML;
  }

  function timeAgo(iso: string): string {
    const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
    if (days < 1) return "today";
    if (days < 30) return `${days}d ago`;
    if (days < 365) return `${Math.floor(days / 30)}mo ago`;
    return `${Math.floor(days / 365)}y ago`;
  }

  function render(byName: Map<string, Repo>) {
    const grid = document.querySelector<HTMLElement>("#repo-grid");
    if (!grid) return;

    grid.innerHTML = SHOWCASE.map(name => {
      const r = byName.get(name) ?? FALLBACKS[name];
      const description = r.description ?? DESCRIPTIONS[name] ?? "";
      const lang = r.language
        ? `<span class="inline-flex items-center gap-1.5"><span class="inline-block size-2 rounded-full" style="background:${LANG_COLORS[r.language] ?? "currentColor"}"></span>${esc(r.language)}</span>`
        : "";
      const stars = r.stargazers_count
        ? `<span>&#9733; ${r.stargazers_count}</span>`
        : "";
      const updated = r.pushed_at
        ? `<span>updated ${timeAgo(r.pushed_at)}</span>`
        : "";
      return `<li>
        <a href="${esc(r.html_url)}" class="border-border hover:border-accent group flex h-full flex-col gap-1 rounded-md border p-4 transition-colors">
          <h3 class="group-hover:text-accent font-semibold">${esc(r.name)}</h3>
          <p class="grow text-sm opacity-80">${esc(description)}</p>
          <span class="mt-2 flex items-center gap-4 text-xs opacity-60">${lang}${stars}${updated}</span>
        </a>
      </li>`;
    }).join("");

    grid.hidden = false;
  }

  async function loadRepos() {
    const grid = document.querySelector<HTMLElement>("#repo-grid");
    if (!grid || grid.childElementCount > 0) return;

    const byName = new Map<string, Repo>();
    try {
      const res = await fetch(
        "https://api.github.com/users/abhinavlal/repos?per_page=100&sort=pushed"
      );
      if (res.ok) {
        const repos: Repo[] = await res.json();
        for (const r of repos) {
          if (SHOWCASE.includes(r.name)) byName.set(r.name, r);
        }
      }
    } catch {
      // API unreachable — fall through and render the static fallbacks.
    }
    render(byName);
  }

  loadRepos();
  document.addEventListener("astro:page-load", loadRepos);
</script>
