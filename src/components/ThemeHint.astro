---
import IconPalette from "@/assets/icons/IconPalette.svg";
import IconX from "@/assets/icons/IconX.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div
  id="theme-hint"
  role="status"
  hidden
  class="bg-background border-border fixed end-4 top-20 z-50 flex w-72 max-w-[calc(100vw-2rem)] items-start gap-2 border p-3 shadow-xl sm:end-6 sm:top-24"
>
  <button
    id="theme-hint-open"
    type="button"
    class="focus-outline flex grow items-start gap-2 text-start"
  >
    <IconPalette class="text-accent mt-0.5 size-5 shrink-0" />
    <span>
      <span class="block text-sm font-semibold">{t.a11y.themeHintTitle}</span>
      <span class="text-muted-foreground mt-1 block text-xs leading-relaxed">
        {t.a11y.themeHintBody}
      </span>
    </span>
  </button>
  <button
    id="theme-hint-close"
    type="button"
    class="focus-outline text-muted-foreground hover:text-foreground -m-1 shrink-0 p-1"
    aria-label={t.a11y.dismiss}
  >
    <IconX class="size-4" />
  </button>
</div>
