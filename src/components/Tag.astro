---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

// Each tag gets a stable colour from the active theme's ANSI palette.
const PALETTE_CLASSES = [
  "border-ansi-red [&>svg]:text-ansi-red",
  "border-ansi-green [&>svg]:text-ansi-green",
  "border-ansi-yellow [&>svg]:text-ansi-yellow",
  "border-ansi-blue [&>svg]:text-ansi-blue",
  "border-ansi-magenta [&>svg]:text-ansi-magenta",
  "border-ansi-cyan [&>svg]:text-ansi-cyan",
];
const hash = [...tag].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) >>> 0, 7);
const paletteClass = PALETTE_CLASSES[hash % PALETTE_CLASSES.length];
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "flex items-center gap-0.5",
      "border-b-2 border-dashed",
      paletteClass,
      "hover:border-accent hover:text-accent hover:-mt-0.5",
      "focus-visible:text-accent focus-visible:border-none",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
