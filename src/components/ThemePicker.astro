---
import IconX from "@/assets/icons/IconX.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { OMARCHY_THEMES } from "@/data/omarchy-themes";
import { OMARCHY_PALETTES } from "@/data/omarchy-palettes";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const { site } = config;
---

<div
  id="theme-menu"
  role="dialog"
  aria-modal="true"
  aria-label={t.a11y.themeMenu}
  hidden
  class="bg-background/90 fixed inset-0 z-50 flex flex-col backdrop-blur-sm"
>
  <div
    class="app-layout flex items-center justify-between gap-4 py-4 text-sm sm:py-6"
  >
    <span class="text-muted-foreground">
      {t.a11y.currentTheme}:{" "}
      <span id="theme-name" class="text-foreground font-medium"></span>
    </span>
    <span class="text-muted-foreground flex items-center gap-2 text-xs">
      <kbd class="bg-muted/60 rounded px-1.5 py-0.5 font-mono text-[10px]">
        ← →
      </kbd>
      <kbd class="bg-muted/60 rounded px-1.5 py-0.5 font-mono text-[10px]">
        Ctrl+Shift+Space
      </kbd>
      <kbd class="bg-muted/60 rounded px-1.5 py-0.5 font-mono text-[10px]">
        Esc
      </kbd>
      <button
        type="button"
        data-theme-close
        class="focus-outline hover:text-accent -m-1 ms-2 p-1"
        aria-label={t.a11y.closeMenu}
      >
        <IconX class="size-5" />
      </button>
    </span>
  </div>

  <div class="relative flex flex-1 items-center">
    <button
      type="button"
      data-theme-prev
      class="focus-outline bg-background/80 border-border hover:text-accent absolute start-4 z-10 flex size-11 items-center justify-center rounded-md border sm:start-8"
      aria-label={t.a11y.previousTheme}
    >
      <IconArrowRight class="size-5 rotate-180" />
    </button>
    <button
      type="button"
      data-theme-next
      class="focus-outline bg-background/80 border-border hover:text-accent absolute end-4 z-10 flex size-11 items-center justify-center rounded-md border sm:end-8"
      aria-label={t.a11y.nextTheme}
    >
      <IconArrowRight class="size-5" />
    </button>

    <div
      id="theme-track"
      role="radiogroup"
      class="flex w-full snap-x snap-mandatory [scrollbar-width:none] gap-6 overflow-x-auto px-[calc(50vw-min(40vw,260px))] py-6 [&::-webkit-scrollbar]:hidden"
    >
      {
        OMARCHY_THEMES.map(theme => {
          const c = theme.colors;
          const p = OMARCHY_PALETTES[theme.slug];
          const swatches = p ? Object.values(p) : [c.accent];
          return (
            <button
              type="button"
              role="radio"
              aria-checked="false"
              data-theme-option={theme.slug}
              tabindex="-1"
              class="group flex w-[min(80vw,520px)] shrink-0 snap-center flex-col items-center gap-3 transition-[transform,opacity] duration-200 outline-none aria-[checked=false]:scale-95 aria-[checked=false]:opacity-50 aria-[checked=false]:hover:opacity-80"
            >
              <div
                aria-hidden="true"
                class="group-aria-checked:ring-accent w-full overflow-hidden rounded-md border text-start shadow-xl ring-offset-2 group-aria-checked:ring-2"
                style={`background:${c.background};color:${c.foreground};border-color:${c.border};--tw-ring-offset-color:${c.background}`}
              >
                <div
                  class="flex items-center justify-between border-b px-5 py-3 text-[11px]"
                  style={`border-color:${c.border}`}
                >
                  <span class="text-sm font-semibold">{site.title}</span>
                  <span
                    class="flex items-center gap-3"
                    style={`color:${c.mutedForeground}`}
                  >
                    <span>{t.nav.posts}</span>
                    <span>{t.nav.tags}</span>
                    <span>{t.nav.about}</span>
                    <span
                      class="size-2.5 rounded-full"
                      style={`background:${c.accent}`}
                    />
                  </span>
                </div>
                <div class="space-y-2 px-5 py-4">
                  <p class="text-xl font-bold">Hi, I&rsquo;m Abhinav.</p>
                  <p class="text-[11px] leading-relaxed">
                    Co-founder &amp; Chief Janitor of{" "}
                    <span
                      class="underline decoration-dashed underline-offset-2"
                      style={`color:${c.accent}`}
                    >
                      Practo
                    </span>
                    . Writing about software, simplicity, and whatever else
                    catches my attention.
                  </p>
                  <div class="border-t pt-3" style={`border-color:${c.border}`}>
                    <p class="text-xs font-medium" style={`color:${c.accent}`}>
                      Tech Debt Is a Choice. Mess Is Not.
                    </p>
                    <p class="text-[10px]" style={`color:${c.mutedForeground}`}>
                      17 Aug, 2026
                    </p>
                  </div>
                  <p
                    class="rounded px-3 py-2 font-mono text-[10px]"
                    style={`background:${c.surface};color:${c.foreground}`}
                  >
                    <span style={`color:${p?.green ?? c.accent}`}>$</span>{" "}
                    omarchy-theme-set{" "}
                    <span style={`color:${c.accent}`}>{theme.slug}</span>
                  </p>
                  <div class="flex gap-1.5 pt-1">
                    {swatches.map(color => (
                      <span
                        class="h-3 flex-1 rounded-sm"
                        style={`background:${color}`}
                      />
                    ))}
                  </div>
                </div>
              </div>
              <span class="flex items-baseline gap-2">
                <span class="text-lg font-semibold">{theme.name}</span>
                <span class="text-muted-foreground text-[10px] uppercase">
                  {theme.mode}
                </span>
              </span>
            </button>
          );
        })
      }
    </div>
  </div>
</div>
